
public class TruckLoadingContainer {
    // Method to load a container onto a truck
    public void loadContainer() {
        // Implementation for loading container
        System.out.println("Container loaded onto the truck.");
    }

    public static void main(String[] args) {
        // Create an instance of TruckLoadingContainer
        TruckLoadingContainer truckLoader = new TruckLoadingContainer();
        
        // Call the method to load the container
        truckLoader.loadContainer();
    }
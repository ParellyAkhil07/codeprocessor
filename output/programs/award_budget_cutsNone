
public class AwardBudgetCuts {

    public static double findGrantCap(double[] grantsArray, double newBudget) {
        // Sort the grants array in descending order
        Arrays.sort(grantsArray);
        int n = grantsArray.length;
        double cap = newBudget / n;
        newBudget = (double) newBudget;
        int i = n - 1;
        boolean flag = false;

        // Iterate to find the cap
        while (!flag) {
            // Adjust newBudget and index i if cap is greater than current grant
            while (cap > grantsArray[i]) {
                newBudget -= grantsArray[i];
                i--;
            }

            // Calculate new cap
            double newCap = newBudget / (i + 1);

            // Check if the cap has stabilized
            if (cap == newCap) {
                flag = true;
            }

            cap = newCap;
        }

        return cap;
    }

    public static void main(String[] args) {
        // Test cases
        System.out.println(findGrantCap(new double[]{2, 100, 50, 120, 1000}, 190)); // Output: 47
        System.out.println(findGrantCap(new double[]{2, 4}, 3)); // Output: 1.5
        System.out.println(findGrantCap(new double[]{2, 4, 6}, 3)); // Output: 1
        System.out.println(findGrantCap(new double[]{2, 100, 50, 120, 1000}, 190)); // Output: 47
        System.out.println(findGrantCap(new double[]{2, 100, 50, 120, 167}, 400)); // Output: 128
        System.out.println(findGrantCap(new double[]{21, 100, 50, 120, 130, 110}, 140)); // Output: 23.8
        System.out.println(findGrantCap(new double[]{210, 200, 150, 193, 130, 110, 209, 342, 117}, 1530)); // Output: 211
    }
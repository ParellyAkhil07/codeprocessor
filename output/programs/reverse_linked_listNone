
class Node {
    // Class representing a node in a linked list
    int data;
    Node next;

    // Constructor to initialize the node
    public Node(int data, Node next) {
        this.data = data;
        this.next = next;
    }

    // Method to represent the data of the node and its successors as a string
    public String asString() {
        StringBuilder out = new StringBuilder();
        Node n = this;

        while (n != null) {
            out.append(n.data);
            n = n.next;
        }

        return out.toString();
    }
}

public class ReverseLinkedList {

    // Method to reverse the linked list
    public static Node reverseLinkedList(Node head) {
        Node prev = null;
        Node curr = head;

        while (curr != null) {
            Node next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = next;
        }

        return prev;
    }

    public static void main(String[] args) {
        // Test the reverseLinkedList method
        Node ll = new Node(1, new Node(2, new Node(3, null)));
        Node reversed = reverseLinkedList(ll);
        System.out.println(reversed.asString()); // Should print '321'

        // Additional test
        Node ll2 = new Node(1, new Node(2, new Node(3, null)));
        Node newLl = reverseLinkedList(ll2);
        System.out.println(newLl.asString()); // Should print '321'
    }

public class StockPrice {

    // Finds the maximum profit for buying and selling stock within a day.
    public static int getMaxProfit(List<Integer> prices) {
        // Initialize max profit with the first possible transaction
        int maxProfit = prices.get(1) - prices.get(0);

        // Iterate over each price
        for (int a = 0; a < prices.size(); a++) { // O(n)
            for (int b = a + 1; b < prices.size(); b++) { // O(n)
                int gainLoss = prices.get(b) - prices.get(a);
                if (gainLoss > maxProfit) {
                    maxProfit = gainLoss;
                }
            }
        }
        System.out.println(maxProfit);
        return maxProfit;
    }

    // Optimized method to find the maximum profit for buying and selling stock within a day.
    public static int getMaxProfitOptimized(List<Integer> prices) {
        // Initialize max profit and lowest price
        int maxProfit = prices.get(1) - prices.get(0);
        int low = prices.get(0);

        // Iterate over each price
        for (int i = 1; i < prices.size(); i++) { // O(n)
            int currentPrice = prices.get(i);
            int potentialProfit = currentPrice - low;
            maxProfit = Math.max(maxProfit, potentialProfit);
            low = Math.min(low, currentPrice);
        }
        System.out.println(maxProfit);
        return maxProfit;
    }

    public static void main(String[] args) {
        // Test cases
        List<Integer> stockPricesYesterday1 = List.of(10, 7, 5, 8, 11, 9);
        getMaxProfit(stockPricesYesterday1);
        getMaxProfitOptimized(stockPricesYesterday1);

        List<Integer> stockPricesYesterday2 = List.of(10, 3);
        getMaxProfit(stockPricesYesterday2);
        getMaxProfitOptimized(stockPricesYesterday2);

        List<Integer> stockPricesYesterday3 = List.of(1, 10, 7, 14, 2, 11);
        getMaxProfit(stockPricesYesterday3);
        getMaxProfitOptimized(stockPricesYesterday3);

        List<Integer> stockPricesYesterday4 = List.of(11, 10, 9, 8, 2, 1);
        getMaxProfit(stockPricesYesterday4);
        getMaxProfitOptimized(stockPricesYesterday4);

        List<Integer> stockPricesYesterday5 = List.of(11, 9, 5, 2, 2, 0);
        getMaxProfit(stockPricesYesterday5);
        getMaxProfitOptimized(stockPricesYesterday5);

        List<Integer> stockPricesYesterday6 = List.of(1, 1, 1, 1, 1, 1);
        getMaxProfit(stockPricesYesterday6);
        getMaxProfitOptimized(stockPricesYesterday6);

        System.out.println("ALL TESTS PASSED");
    }
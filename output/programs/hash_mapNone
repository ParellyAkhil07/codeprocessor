
import java.util.ArrayList;
import java.util.List;

public class HashMap {

    private List<List<KeyValuePair>> hash;

    // Constructor to initialize the hash map with 64 empty lists
    public HashMap() {
        hash = new ArrayList<>();
        for (int i = 0; i < 64; i++) {
            hash.add(new ArrayList<>());
        }
    }

    // Hashing function to calculate the index for a given key
    private int hashing(String key) {
        int value = 0;
        // Calculate the total ASCII value of the key
        for (char c : key.toCharArray()) {
            value += (int) c;
        }
        // Return index in the range of 0 to 63
        return value % 64;
    }

    // Method to find the value associated with a key
    public String findVal(String key) throws KeyNotFoundException {
        int index = hashing(key);
        List<KeyValuePair> position = hash.get(index);

        if (!position.isEmpty()) {
            // Loop through items at hashed index to find the key
            for (KeyValuePair item : position) {
                if (item.getKey().equals(key)) {
                    return item.getValue();
                }
            }
            throw new KeyNotFoundException("Key does not exist.");
        } else {
            throw new KeyNotFoundException("Key does not exist.");
        }
    }

    // Method to update or add a new key-value pair
    public void updateOrAdd(String key, String val) {
        int index = hashing(key);
        List<KeyValuePair> position = hash.get(index);

        if (!position.isEmpty()) {
            // Update the value if the key exists
            for (KeyValuePair item : position) {
                if (item.getKey().equals(key)) {
                    item.setValue(val);
                    return;
                }
            }
            // If no key exists, add new key-value pair
            position.add(new KeyValuePair(key, val));
        } else {
            // If list is empty, add new key-value pair
            position.add(new KeyValuePair(key, val));
        }
    }

    // Method to delete a key-value pair
    public void delete(String key) throws KeyNotFoundException {
        int index = hashing(key);
        List<KeyValuePair> position = hash.get(index);

        if (!position.isEmpty()) {
            for (int i = 0; i < position.size(); i++) {
                if (position.get(i).getKey().equals(key)) {
                    position.remove(i);
                    return;
                }
            }
            throw new KeyNotFoundException("Key does not exist.");
        } else {
            throw new KeyNotFoundException("Key does not exist.");
        }
    }

    // Inner class to represent a key-value pair
    private static class KeyValuePair {
        private String key;
        private String value;

        public KeyValuePair(String key, String value) {
            this.key = key;
            this.value = value;
        }

        public String getKey() {
            return key;
        }

        public String getValue() {
            return value;
        }

        public void setValue(String value) {
            this.value = value;
        }
    }

    // Custom exception for key not found
    public static class KeyNotFoundException extends Exception {
        public KeyNotFoundException(String message) {
            super(message);
        }
    }
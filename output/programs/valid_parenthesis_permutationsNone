// Observations:
// - All permutations start with opens
// - Base case: if num of open used == num of closed used
// - Num of opens used up, then next to the end must be closed

import java.util.ArrayList;
import java.util.List;
import org.junit.Test;
import static org.junit.Assert.assertEquals;

public class ValidParenthesisPermutations {

    public static List<String> validParensPerms(int num) {
        List<String> result = new ArrayList<>();
        
        // Helper function to recurse through permutations
        recurse("", num, num, result);
        
        return result;
    }

    private static void recurse(String substr, int left, int right, List<String> result) {
        // Base case: if no more left or right parentheses to add
        if (left == 0 && right == 0) {
            result.add(substr);
            return;
        }

        // If no left parentheses remaining, add right parentheses
        if (left == 0) {
            recurse(substr + ")", left, right - 1, result);
        }

        // If there are more right parentheses than left, add both
        else if (left < right) {
            recurse(substr + "(", left - 1, right, result);
            recurse(substr + ")", left, right - 1, result);
        }

        // If left and right are equal, only add left parentheses
        else if (left == right) {
            recurse(substr + "(", left - 1, right, result);
        }
    }

    public static class Testing {
        @Test
        public void testValidParensPerms() {
            assertEquals(List.of("()"), validParensPerms(1));
            assertEquals(List.of("(())", "()()"), validParensPerms(2));
            assertEquals(List.of("((()))", "(()())", "(())()", "()(())", "()()()"), validParensPerms(3));
            assertEquals(List.of("(((())))", "((()()))", "((())())", "((()))()", "(()(()))", "(()()())", "(()())()", "(())(())", "(())()()", "()((()))", "()(()())", "()(())()", "()()(())", "()()()()"), validParensPerms(4));
        }
    }

    public static void main(String[] args) {
        org.junit.runner.JUnitCore.main("ValidParenthesisPermutations$Testing");
    }
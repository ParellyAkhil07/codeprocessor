import java.util.Collections;
import java.util.List;
import java.util.Random;

public class SortFractions {

    public static void main(String[] args) {
        List<Double> nums = new ArrayList<>();
        Random random = new Random();

        // Generate 100 random numbers between 0 and 1000 with 3 decimal places
        for (int i = 0; i < 100; i++) {
            double num = Math.round(random.nextDouble() * 1000 * 1000.0) / 1000.0;
            nums.add(num);
        }

        // Print the sorted list based on fractional parts
        System.out.println(sortFractional(nums));
    }

    // Sort numbers based on their fractional parts
    public static List<String> sortFractional(List<Double> nums) {
        List<String> fractionalParts = new ArrayList<>();

        // Extract fractional part as a string
        for (Double num : nums) {
            String numStr = num.toString();
            int index = numStr.indexOf('.');
            if (index != -1) {
                fractionalParts.add(numStr.substring(index + 1));
            } else {
                fractionalParts.add("0"); // Handle numbers without a fractional part
            }
        }

        // Sort the fractional parts
        Collections.sort(fractionalParts);
        return fractionalParts;
    }
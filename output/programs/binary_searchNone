
public class BinarySearch {

    // Using binary search, find val in range 1-100. Return # of guesses.
    public static int binarySearch(int val) {
        // Assert that val is between 1 and 100
        if (val <= 0 || val >= 101) {
            throw new IllegalArgumentException("Val must be between 1-100");
        }

        int numGuesses = 0;
        int guess = -1;
        int low = 0;
        int high = 101;

        // Perform binary search
        while (guess != val) {
            numGuesses++;
            guess = (high - low) / 2 + low;

            if (guess > val) {
                high = guess;
            } else if (guess < val) {
                low = guess;
            }
        }

        return numGuesses;
    }

    public static void main(String[] args) {
        // Test cases
        System.out.println(binarySearch(50)); // Should return 1
        System.out.println(binarySearch(25)); // Should return 2
        System.out.println(binarySearch(75)); // Should return 2
        System.out.println(binarySearch(31) <= 7); // Should return true

        // Check maximum guesses for numbers 1 to 100
        int maxGuesses = 0;
        for (int i = 1; i <= 100; i++) {
            maxGuesses = Math.max(maxGuesses, binarySearch(i));
        }
        System.out.println(maxGuesses); // Should return 7

        System.out.println("ALL TESTS PASSED");
    }
import java.util.*;

class ETLClient {

    public String run(DocumentService service, int maxRequests) {
        // Initialize document storage
        Map<String, Object> documents = new HashMap<>();
        documents.put("doc-count", 0);
        documents.put("error-count", 0);
        documents.put("docs", new HashMap<String, List<String>>());

        for (int i = 0; i < maxRequests; i++) {
            while (true) {
                try {
                    Map<String, Object> event = service.handleRequest();

                    if (event.get("operation").equals("add")) {
                        // Handle 'add' operation
                        Map<String, String> document = (Map<String, String>) event.get("document");
                        String docId = document.get("id");
                        List<String> docData = removeWords(document.get("data"));

                        // Add new document
                        ((Map<String, List<String>>) documents.get("docs")).put(docId, docData);
                        documents.put("doc-count", (int) documents.get("doc-count") + 1);

                    } else if (event.get("operation").equals("update")) {
                        // Handle 'update' operation
                        Map<String, String> document = (Map<String, String>) event.get("document");
                        String docId = document.get("id");
                        List<String> docData = removeWords(document.get("data"));

                        // Update document data
                        ((Map<String, List<String>>) documents.get("docs")).put(docId, docData);

                    } else if (event.get("operation").equals("delete")) {
                        // Handle 'delete' operation
                        String docId = (String) event.get("document-id");
                        Map<String, List<String>> docs = (Map<String, List<String>>) documents.get("docs");

                        if (docs.containsKey(docId)) {
                            docs.remove(docId);
                            documents.put("doc-count", (int) documents.get("doc-count") - 1);
                        }
                    }

                } catch (RetryImmediatelyError e) {
                    // Handle retry error
                    documents.put("error-count", (int) documents.get("error-count") + 1);
                    continue;
                }
                break;
            }
        }

        // Convert documents map to JSON string
        return new JSONObject(documents).toString();
    }

    private List<String> removeWords(String data) {
        // Remove unwanted words and convert to lowercase
        Set<String> removeWords = new HashSet<>(Arrays.asList("and", "or", "not", "but", "to", "in"));
        List<String> words = new ArrayList<>(Arrays.asList(data.toLowerCase().split(" ")));

        words.removeIf(removeWords::contains);

        return words;
    }
}


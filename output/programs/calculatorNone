import static org.junit.Assert.assertEquals;
import java.util.Stack;

public class Calculator {

    public static double evaluate(String expression) {
        expression = expression.replaceAll(" ", "");
        Stack<Integer> parensIndices = new Stack<>();
        StringBuilder storage = new StringBuilder();
        int[] operators = new int[4]; // 0: *, 1: /, 2: +, 3: -

        for (int i = 0; i < expression.length(); i++) {
            char charAt = expression.charAt(i);
            if (charAt == '(') {
                parensIndices.push(i);
            } else if (charAt == ')') {
                int start = parensIndices.pop() + 1;
                double total = calculate(expression.substring(start, i), operators);
                storage.setLength(start - 1);
                storage.append(total);
            } else {
                storage.append(charAt);
            }

            if (charAt == '*') operators[0]++;
            if (charAt == '/') operators[1]++;
            if (charAt == '+') operators[2]++;
            if (charAt == '-') operators[3]++;
        }

        return calculate(storage.toString(), operators);
    }

    private static double calculate(String innerExpression, int[] operators) {
        double total = 0;
        StringBuilder newExpr = new StringBuilder(innerExpression);

        while (operators[0] > 0) {
            int opIndex = newExpr.indexOf("*");
            double prev = Double.parseDouble(String.valueOf(newExpr.charAt(opIndex - 1)));
            double nxt = Double.parseDouble(String.valueOf(newExpr.charAt(opIndex + 1)));
            total = prev * nxt;
            newExpr.replace(opIndex - 1, opIndex + 2, String.valueOf(total));
            operators[0]--;
        }

        while (operators[1] > 0) {
            int opIndex = newExpr.indexOf("/");
            double prev = Double.parseDouble(String.valueOf(newExpr.charAt(opIndex - 1)));
            double nxt = Double.parseDouble(String.valueOf(newExpr.charAt(opIndex + 1)));
            total = prev / nxt;
            newExpr.replace(opIndex - 1, opIndex + 2, String.valueOf(total));
            operators[1]--;
        }

        while (operators[3] > 0) {
            int opIndex = newExpr.indexOf("-");
            double prev = Double.parseDouble(String.valueOf(newExpr.charAt(opIndex - 1)));
            double nxt = Double.parseDouble(String.valueOf(newExpr.charAt(opIndex + 1)));
            total = prev - nxt;
            newExpr.replace(opIndex - 1, opIndex + 2, String.valueOf(total));
            operators[3]--;
        }

        while (operators[2] > 0) {
            int opIndex = newExpr.indexOf("+");
            double prev = Double.parseDouble(String.valueOf(newExpr.charAt(opIndex - 1)));
            double nxt = Double.parseDouble(String.valueOf(newExpr.charAt(opIndex + 1)));
            total = prev + nxt;
            newExpr.replace(opIndex - 1, opIndex + 2, String.valueOf(total));
            operators[2]--;
        }

        return total;
    }

    public static class Testing {

        @Test
        public void testNoParens() {
            assertEquals(7, evaluate("1 + 3 * 2"), 0.001);
        }

        @Test
        public void testSingleParens() {
            assertEquals(16, evaluate("(1 + 7) * 2"), 0.001);
        }

        @Test
        public void testOperationsOrder() {
            assertEquals(29, evaluate("4 * (1 + 7) - 3"), 0.001);
        }

        @Test
        public void testLongParens() {
            assertEquals(-6, evaluate("(4 - 7 - 1) * 3"), 0.001);
        }

        @Test
        public void testDecimals() {
            assertEquals(6.25, evaluate("(1.2 + 1.3) * 2.5"), 0.001);
        }
    }
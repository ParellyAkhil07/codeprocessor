// Can't use built-in reverse methods

public class ReverseString {

    // Method 1: Using a loop to reverse the string
    public static String revStr(String string) {
        // Initialize an empty string to store the reversed string
        String reversedStr = "";
        // Convert the string to a character array
        char[] listStr = string.toCharArray();
        // Iterate over the character array from the end to the beginning
        for (int i = listStr.length - 1; i >= 0; i--) {
            // Append each character to the reversed string
            reversedStr += listStr[i];
        }
        return reversedStr;
    }

    // Method 2: Using StringBuilder to reverse the string
    public static String revStr2(String string) {
        // Use StringBuilder to reverse the string
        return new StringBuilder(string).reverse().toString();
    }

    // Method 3: Using recursion to reverse the string
    public static String revStr3(String string) {
        // Base case: if the string is empty, return it
        if (string.length() == 0) {
            return string;
        }
        // Recursive case: return the last character + reverse of the rest
        return string.charAt(string.length() - 1) + revStr3(string.substring(0, string.length() - 1));
    }

    public static void main(String[] args) {
        // Test cases
        assert revStr("hello").equals("olleh");
        assert revStr("1234h").equals("h4321");
        assert revStr("").equals("");

        assert revStr2("hello").equals("olleh");
        assert revStr2("1234h").equals("h4321");
        assert revStr2("").equals("");

        assert revStr3("hello").equals("olleh");
        assert revStr3("1234h").equals("h4321");
        assert revStr3("").equals("");

        System.out.println("ALL TESTS PASSED!");
    }
import java.util.Collections;
import java.util.Comparator;
import java.util.List;

public class MergeRanges {

    public static List<int[]> mergeRanges(List<int[]> lst) {
        // Sort the meeting times based on the start time
        Collections.sort(lst, Comparator.comparingInt(a -> a[0]));

        // Initialize the merged range list with the first meeting time
        List<int[]> mergedRange = new ArrayList<>();
        mergedRange.add(lst.get(0));

        // Iterate over the sorted meeting times
        for (int i = 1; i < lst.size(); i++) {
            int[] currentMeeting = lst.get(i);
            int[] lastMergedMeeting = mergedRange.get(mergedRange.size() - 1);

            // If the current meeting overlaps with the last merged meeting, merge them
            if (lastMergedMeeting[1] >= currentMeeting[0]) {
                lastMergedMeeting[1] = Math.max(lastMergedMeeting[1], currentMeeting[1]);
            } else {
                // Otherwise, add the current meeting as a new entry in the merged list
                mergedRange.add(currentMeeting);
            }
        }

        return mergedRange;
    }

    public static void main(String[] args) {
        // Test cases
        List<int[]> test1 = List.of(new int[]{3, 5}, new int[]{4, 8}, new int[]{10, 12}, new int[]{9, 10}, new int[]{0, 1});
        List<int[]> test2 = List.of(new int[]{0, 3}, new int[]{3, 5}, new int[]{4, 8}, new int[]{10, 12}, new int[]{9, 10});
        List<int[]> test3 = List.of(new int[]{0, 3}, new int[]{3, 5});
        List<int[]> test4 = List.of(new int[]{0, 3}, new int[]{3, 5}, new int[]{7, 8});
        List<int[]> test5 = List.of(new int[]{1, 5}, new int[]{2, 3});

        // Print results
        System.out.println(mergeRanges(test1)); // Expected: [[0, 1], [3, 8], [9, 12]]
        System.out.println(mergeRanges(test2)); // Expected: [[0, 8], [9, 12]]
        System.out.println(mergeRanges(test3)); // Expected: [[0, 5]]
        System.out.println(mergeRanges(test4)); // Expected: [[0, 5], [7, 8]]
        System.out.println(mergeRanges(test5)); // Expected: [[1, 5]]
    }
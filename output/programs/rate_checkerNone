import java.util.LinkedList;
import java.util.Queue;

public class RateChecker {

    private int actions;
    private int seconds;
    private Queue<LocalTime> times; // Queue to keep track of check times

    public RateChecker(int actions, int seconds) {
        this.actions = actions;
        this.seconds = seconds;
        this.times = new LinkedList<>();
    }

    public boolean check() {
        LocalTime currentTime = LocalTime.now();
        times.add(currentTime); // Append each check time to the queue

        if (times.size() > actions) { // Check if the queue size is greater than the number of actions
            return false; // Quick return if the condition is met
        }

        // Calculate the difference between the current time and the oldest time in the queue
        LocalTime oldestTime = times.poll();
        return java.time.Duration.between(oldestTime, currentTime).getSeconds() <= seconds;
    }

    public static void main(String[] args) {
        RateChecker clicks = new RateChecker(3, 14);
        System.out.println(clicks.check()); // Example usage
        System.out.println(clicks.check());
        System.out.println(clicks.check());
        System.out.println(clicks.check());
    }
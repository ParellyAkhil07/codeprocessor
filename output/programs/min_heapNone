import java.util.List;

class MinHeap {
    private List<Integer> storage;

    public MinHeap() {
        this.storage = new ArrayList<>();
    }

    // Swap elements at indices a and b
    private void swap(int a, int b) {
        int temp = storage.get(a);
        storage.set(a, storage.get(b));
        storage.set(b, temp);
    }

    // Return the size of the heap
    public int size() {
        return storage.size();
    }

    // Return the minimum element (peak) of the heap
    public int peak() {
        return storage.get(0);
    }

    // Insert a new value into the heap
    public void insert(int value) {
        storage.add(value);
        int index = size() - 1;
        bubbleUp(index);
    }

    // Get the parent index of a given child index
    private int getParent(int child) {
        if (child % 2 == 0) {
            return (child - 2) / 2;
        } else {
            return (child - 1) / 2;
        }
    }

    // Bubble up the element at the given child index
    private void bubbleUp(int child) {
        int parent = getParent(child);

        while (child > 0 && parent >= 0 && storage.get(child) < storage.get(parent)) {
            swap(child, parent);
            child = parent;
            parent = getParent(child);
        }
    }

    // Remove and return the minimum element (peak) of the heap
    public int removePeak() {
        swap(0, size() - 1);
        int minElem = storage.remove(size() - 1);
        bubbleDown(0);
        return minElem;
    }

    // Get the child index of a given parent index
    private Integer getChild(int parent) {
        int child1 = 2 * parent + 1;
        int child2 = 2 * parent + 2;

        if (child1 >= size()) {
            return null;
        } else if (child2 >= size()) {
            return child1;
        } else if (storage.get(child1) < storage.get(child2)) {
            return child1;
        } else {
            return child2;
        }
    }

    // Bubble down the element at the given parent index
    private void bubbleDown(int parent) {
        Integer child = getChild(parent);

        while (child != null && storage.get(parent) > storage.get(child)) {
            swap(child, parent);
            parent = child;
            child = getChild(parent);
        }
    }

    // Remove a specific item from the heap
    public int remove(int item) {
        int lastIndex = size() - 1;
        int swapIndex = 0;

        for (int i = 0; i < storage.size(); i++) {
            if (item == storage.get(i)) {
                swapIndex = i;
                swap(i, lastIndex);
                break;
            }
        }

        bubbleUp(swapIndex);
        bubbleDown(swapIndex);

        return storage.remove(size() - 1);
    }

    @Override
    public String toString() {
        return "<storage = " + storage + ">";
    }

    public static void main(String[] args) {
        // Example usage and testing
        MinHeap heap = new MinHeap();
        heap.insert(4);
        heap.insert(5);
        heap.insert(6);
        heap.insert(7);
        heap.insert(8);

        System.out.println(heap); // <storage = [4, 5, 6, 7, 8]>
        System.out.println(heap.removePeak()); // 4
        System.out.println(heap); // <storage = [5, 7, 6, 8]>
    }
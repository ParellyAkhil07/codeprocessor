import java.util.*;
import java.util.regex.*;
import com.opencsv.*;

public class FindMatches {
    private String matchingType;
    private String inputFile;
    private int rownum = 0;
    private String[] header;
    private Integer emailCol2 = null;
    private Integer emailCol = null;
    private Integer phoneCol2 = null;
    private Integer phoneCol = null;
    private Map<String, Integer> ids = new HashMap<>();
    private int id = 1;

    public FindMatches(String inputFile, String matchingType) throws IOException {
        this.matchingType = matchingType.toLowerCase();
        if (!Arrays.asList("email", "phone", "email_phone").contains(this.matchingType)) {
            System.out.println("Please use a valid matching type: 'email', 'phone', or 'email_phone'.");
            return;
        }

        this.inputFile = inputFile;
        CSVReader reader = new CSVReader(new FileReader(this.inputFile));
        String[] row;

        // Read header
        if ((row = reader.readNext()) != null) {
            this.header = row;
            this.rownum++;
        }

        // Get column numbers for email
        for (int col = 0; col < this.header.length; col++) {
            if (this.header[col].toLowerCase().contains("email2")) {
                this.emailCol2 = col;
            }
            if (this.header[col].toLowerCase().equals("email1") || this.header[col].toLowerCase().equals("email")) {
                this.emailCol = col;
            }
        }

        // Get column numbers for phone
        for (int col = 0; col < this.header.length; col++) {
            if (this.header[col].toLowerCase().contains("phone2")) {
                this.phoneCol2 = col;
            }
            if (this.header[col].toLowerCase().equals("phone1") || this.header[col].toLowerCase().equals("phone")) {
                this.phoneCol = col;
            }
        }

        // Write to csv after all ids are assigned
        writeCsv(reader);
    }

    private int emailMatch(String[] row, Integer minId) {
        Integer rowId = null;
        int iden = (minId != null) ? minId : this.id;

        if (this.emailCol2 != null && row[this.emailCol2] != null && !row[this.emailCol2].isEmpty()) {
            String email2 = row[this.emailCol2];
            addKeyToDict(email2, iden);
            if (this.ids.containsKey(email2)) {
                rowId = this.ids.get(email2);
            }
        }

        if (this.emailCol != null && row[this.emailCol] != null && !row[this.emailCol].isEmpty()) {
            String email1 = row[this.emailCol];
            addKeyToDict(email1, iden);
            rowId = this.ids.getOrDefault(email1, this.id);
        }

        if (rowId == null) {
            rowId = this.id;
        }

        return rowId;
    }

    private String formatPhone(String[] row, int column) {
        String formattedPhone = row[column].replaceAll("\\D+", "");
        if (formattedPhone.length() > 10) {
            formattedPhone = formattedPhone.substring(1);
        }
        return formattedPhone;
    }

    private int phoneMatch(String[] row, Integer minId) {
        Integer rowId = null;
        int iden = (minId != null) ? minId : this.id;

        if (this.phoneCol2 != null && row[this.phoneCol2] != null && !row[this.phoneCol2].isEmpty()) {
            String idsKey = formatPhone(row, this.phoneCol2);
            addKeyToDict(idsKey, iden);
            if (this.ids.containsKey(idsKey)) {
                rowId = this.ids.get(idsKey);
            }
        }

        if (this.phoneCol != null && row[this.phoneCol] != null && !row[this.phoneCol].isEmpty()) {
            String idsKey = formatPhone(row, this.phoneCol);
            addKeyToDict(idsKey, iden);
            rowId = this.ids.getOrDefault(idsKey, this.id);
        }

        if (rowId == null) {
            rowId = this.id;
        }

        return rowId;
    }

    private void addKeyToDict(String idsKey, int iden) {
        this.ids.putIfAbsent(idsKey, iden);
    }

    private void writeCsv(CSVReader reader) throws IOException {
        CSVWriter writer = new CSVWriter(new FileWriter("output_file.csv"));
        List<String[]> allRows = reader.readAll();
        String[] newHeader = new String[this.header.length + 1];
        newHeader[0] = "id";
        System.arraycopy(this.header, 0, newHeader, 1, this.header.length);
        writer.writeNext(newHeader);

        for (String[] row : allRows) {
            Integer rowId = null;
            Integer emailRowId = null;
            Integer phoneRowId = null;

            if (this.matchingType.equals("email")) {
                Integer minId = null;
                if ((this.emailCol2 != null && this.ids.containsKey(row[this.emailCol2])) ||
                    (this.emailCol != null && this.ids.containsKey(row[this.emailCol]))) {
                    Integer email2Exists = this.ids.get(row[this.emailCol2]);
                    Integer emailExists = this.ids.get(row[this.emailCol]);
                    minId = Collections.min(Arrays.asList(email2Exists, emailExists), Comparator.nullsLast(Integer::compareTo));
                }
                rowId = emailMatch(row, minId);
            } else if (this.matchingType.equals("phone")) {
                Integer minId = null;
                if ((this.phoneCol2 != null && this.ids.containsKey(formatPhone(row, this.phoneCol2))) ||
                    (this.phoneCol != null && this.ids.containsKey(formatPhone(row, this.phoneCol)))) {
                    Integer phone2Exists = this.ids.get(formatPhone(row, this.phoneCol2));
                    Integer phoneExists = this.ids.get(formatPhone(row, this.phoneCol));
                    minId = Collections.min(Arrays.asList(phone2Exists, phoneExists), Comparator.nullsLast(Integer::compareTo));
                }
                rowId = phoneMatch(row, minId);
            } else if (this.matchingType.equals("email_phone")) {
                Integer minId = null;
                if ((this.emailCol2 != null && this.ids.containsKey(row[this.emailCol2])) ||
                    (this.emailCol != null && this.ids.containsKey(row[this.emailCol])) ||
                    (this.phoneCol2 != null && this.ids.containsKey(formatPhone(row, this.phoneCol2))) ||
                    (this.phoneCol != null && this.ids.containsKey(formatPhone(row, this.phoneCol)))) {
                    Integer email2Exists = this.ids.get(row[this.emailCol2]);
                    Integer emailExists = this.ids.get(row[this.emailCol]);
                    Integer phone2Exists = this.ids.get(formatPhone(row, this.phoneCol2));
                    Integer phoneExists = this.ids.get(formatPhone(row, this.phoneCol));
                    minId = Collections.min(Arrays.asList(email2Exists, emailExists, phone2Exists, phoneExists), Comparator.nullsLast(Integer::compareTo));
                    rowId = minId;
                }
                emailRowId = emailMatch(row, minId);
                phoneRowId = phoneMatch(row, minId);
                rowId = Math.min(emailRowId, phoneRowId);
            }

            String[] newRow = new String[row.length + 1];
            newRow[0] = rowId.toString();
            System.arraycopy(row, 0, newRow, 1, row.length);
            writer.writeNext(newRow);
            this.id++;
        }
        writer.close();
    }

    public static void main(String[] args) throws IOException {
        new FindMatches(args[0], args[1]);
    }